{
  "name": "de-uplc-web",
  "version": "0.0.1",
  "private": true,
  "description": "de-uplc as a standalone web app (monorepo).",
  "comment": "Workspace globs live in pnpm-workspace.yaml. The root package.json intentionally omits an npm \"workspaces\" field: @de-uplc/* are resolved via Vite aliases (M3), and npm chokes on the packages' pnpm-style \"workspace:*\" deps. Switch to pnpm to use real workspace linking.",
  "scripts": {
    "typecheck": "tsc --noEmit -p packages/core/tsconfig.json && tsc --noEmit -p packages/engine-worker/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "typecheck:core": "tsc --noEmit -p packages/core/tsconfig.json",
    "typecheck:worker": "tsc --noEmit -p packages/engine-worker/tsconfig.json",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "check:schema": "node packages/core/scripts/check-types.cjs",
    "gen:heat": "node scripts/gen-heat-tokens.mjs",
    "check:heat": "node scripts/gen-heat-tokens.mjs --check",
    "lint:core": "eslint -c packages/core/eslint.config.mjs packages/core/src",
    "build:wasm": "packages/engine-wasm/build.sh",
    "predev": "node scripts/ensure-wasm.mjs",
    "dev": "vite --config apps/web/vite.config.ts",
    "prebuild:web": "node scripts/ensure-wasm.mjs",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "e2e": "node apps/web/e2e/m6-headless.mjs && node apps/web/e2e/lazy-headless.mjs && node apps/web/e2e/program-headless.mjs && node apps/web/e2e/context-headless.mjs && node apps/web/e2e/profile-headless.mjs",
    "e2e:m6": "node apps/web/e2e/m6-headless.mjs",
    "e2e:lazy": "node apps/web/e2e/lazy-headless.mjs",
    "e2e:program": "node apps/web/e2e/program-headless.mjs",
    "e2e:context": "node apps/web/e2e/context-headless.mjs",
    "e2e:profile": "node apps/web/e2e/profile-headless.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/react": "^18.3.30",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@vscode/codicons": "^0.0.36",
    "puppeteer-core": "^23.11.1",
    "puppeteer": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^2.1.9",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "comlink": "^4.4.2",
    "monaco-editor": "^0.52.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
